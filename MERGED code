# Helper: map a_dom names to IO indices using INPUT_SECTORS
# If INPUT_SECTORS entry is NA, the insertion will be skipped and a warning emitted.
insert_column_from_res <- function(res, target_col) {
  for (sec_name in names(res$a_dom)) {
    io_index <- INPUT_SECTORS[[sec_name]]
    if (is.na(io_index)) {
      warning("Skipping insertion for domain input '", sec_name, "' because INPUT_SECTORS mapping is missing. Update INPUT_SECTOR_NAME_MAP.")
      next
    }
    if (io_index > N) {
      stop("INPUT_SECTORS index for '", sec_name, "' (", io_index, ") exceeds nIndustries (", N, ").")
    }
    A_dom_S1_2030[io_index, target_col] <- res$a_dom[sec_name]
  }

  # Imported agriculture (example): map "agriculture_imp"
  imp_idx <- INPUT_SECTORS[["agriculture"]]
  if (!is.na(imp_idx) && imp_idx <= N) {
    # Place agriculture_imp into the same agriculture row of A_imp (common representation)
    A_imp_S1_2030[imp_idx, target_col] <- res$a_imp["agriculture_imp"]
  } else {
    warning("Cannot insert imported agriculture coefficient: INPUT_SECTORS[['agriculture']] missing or out of range.")
  }
}

