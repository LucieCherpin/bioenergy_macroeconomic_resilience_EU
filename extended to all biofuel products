# ===================================================================
# 4. UNIVERSAL COLUMN ASSEMBLY ENGINE
# ===================================================================

build_fuel_column <- function(fuel_name, scenario_year_key) {
  
  # Fetch parameters for specific fuel, scenario, and year
  fuel_cfg <- scenario_config[[scenario_year_key]][[fuel_name]]
  weights  <- fuel_cfg$weights
  
  # Initialize empty vectors
  num_dom <- 16 # length of a_dom vector
  a_dom_aggregate <- numeric(num_dom)
  a_imp_aggregate <- numeric(2)
  
  # Loop over active IVCs and aggregate
    for (ivc_id in names(weights)) {
    w_k <- weights[ivc_id]
    
    # Retrieve static  parameters
    tech_base <- IVC_TECH_LIBRARY[[ivc_id]]
    
    prod_cost_k    <- tech_base$prod_cost     
    market_value_k <- tech_base$market_value  
    alpha_k        <- tech_base$alpha
    dist_capex_k   <- tech_base$dist_capex
    dist_opex_k    <- tech_base$dist_opex
    
    # Retrieve scenario/year specific parameters
    dist_feed_k    <- fuel_cfg$dist_feed[[ivc_id]]
    
    # Run calculation for this IVC
   ivc_res <- build_ivc_vector(
      prod_cost    = prod_cost_k,       # Read from IVC_TECH_LIBRARY
      market_value = market_value_k,    # Read from IVC_TECH_LIBRARY
      alpha_cost   = alpha_k,           # Read from IVC_TECH_LIBRARY
      dist_feed    = dist_feed_k,       # Read froom Scen-specific configuration
      dist_capex   = dist_capex_k,      # Read from IVC_TECH_LIBRARY
      dist_opex    = dist_opex_k        # Read from IVC_TECH_LIBRARY
    )
    
    # Weighted recombination
    if (is.null(names(a_dom_aggregate))) names(a_dom_aggregate) <- names(ivc_res$a_dom)
    if (is.null(names(a_imp_aggregate))) names(a_imp_aggregate) <- names(ivc_res$a_imp)
    
    a_dom_aggregate <- a_dom_aggregate + (w_k * ivc_res$a_dom)
    a_imp_aggregate <- a_imp_aggregate + (w_k * ivc_res$a_imp)
  }
  
  return(list(a_dom = a_dom_aggregate, a_imp = a_imp_aggregate))
}

