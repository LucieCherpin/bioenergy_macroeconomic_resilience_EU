  if (is.null(col_idx) || col_idx < 1 || col_idx > N) next
  X_S1_2030[col_idx] <- scenario_config[["S1_2030"]][[fuel_name]][["abs_production_eur"]]
}

# Calculate absolute intermediate transaction matrices Z (in same monetary units as X)
Z_dom_S1_2030 <- A_dom_S1_2030 %*% diag(X_S1_2030)
Z_imp_S1_2030 <- A_imp_S1_2030 %*% diag(X_S1_2030)

##########################################
### STEP 8: Leontief inverse & multipliers
##########################################

I_mat <- diag(N)
L_dom_S1_2030 <- tryCatch(solve(I_mat - A_dom_S1_2030), error = function(e) {
  stop("Failed to invert (I - A_dom_S1_2030). Check A_dom for numeric stability / sizes.")
})

biofuel_multipliers <- data.frame(
  Sector_Name    = character(),
  IO_Index       = integer(),
  Direct_Inputs  = numeric(),
  Indirect_Mult  = numeric(),
  Total_Output_M = numeric(),
  stringsAsFactors = FALSE
)

for (fuel_name in names(scenario_config[["S1_2030"]])) {
  col_idx <- BIOFUEL_SECTORS[[fuel_name]]
  if (is.null(col_idx) || col_idx < 1 || col_idx > N) next

  total_mult <- sum(L_dom_S1_2030[, col_idx])
  direct_req <- sum(A_dom_S1_2030[, col_idx])
  indirect_mult <- total_mult - 1 - direct_req

  biofuel_multipliers <- rbind(biofuel_multipliers, data.frame(
    Sector_Name    = fuel_name,
    IO_Index       = col_idx,
    Direct_Inputs  = round(direct_req, 6),
    Indirect_Mult  = round(indirect_mult, 6),
    Total_Output_M = round(total_mult, 6),
    stringsAsFactors = FALSE
  ))
}

cat("--- BIOFUEL SECTOR MULTIPLIERS (S1 2030) ---\n")
print(biofuel_multipliers)

