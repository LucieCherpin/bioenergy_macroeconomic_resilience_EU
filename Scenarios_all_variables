get_v <- function(vec, k) {
  if (k %in% names(vec)) unname(vec[k]) else 0
}

## this  is like the technical coefficient vector for each IVC (not full biofuel product yet!)

build_ivc_vector <- function(prod_cost, market_value, alpha_cost,
                             dist_feed, dist_capex, dist_opex) {
  
  r_k     <- prod_cost / market_value
  s_feed  <- r_k * alpha_cost["feed"]
  s_capex <- r_k * alpha_cost["capex"]
  s_opex  <- r_k * alpha_cost["opex"]
  
 # Raw monetary feedstock components.
# Negative values represent revenues / gate-fee credits,
# not purchases of intermediate inputs.
a_feed_raw <- s_feed * dist_feed

# Only positive purchased inputs enter the IO technical coefficients.
a_feed <- pmax(a_feed_raw, 0)

# Negative feedstock components are stored separately as revenues.
gate_fee_coeff <- -sum(pmin(a_feed_raw, 0))

a_capex <- s_capex * dist_capex
a_opex  <- s_opex * dist_opex
  
  a_dom <- c(
    agriculture    = get_v(a_feed, "agriculture"),
    forestry       = get_v(a_feed, "forestry"),
    paper          = get_v(a_feed, "paper"),
    food_bev       = get_v(a_feed, "food_bev"),
    sewerage       = get_v(a_feed, "sewerage") + get_v(a_opex, "sewerage"),
    adv_biodiesel  = get_v(a_feed, "adv_biodiesel"),
    adv_biogasoline = get_v(a_feed, "adv_biogasoline"),
    adv_bio_hfo    = get_v(a_feed, "adv_bio_hfo"),
    adv_biogas     = get_v(a_feed, "adv_biogas"),
    fab_metal      = get_v(a_capex, "fab_metal"),
    elec_equip     = get_v(a_capex, "elec_equip"),
    machinery      = get_v(a_capex, "machinery"),
    construction   = get_v(a_capex, "construction"),
    architecture   = get_v(a_capex, "architecture"),
    computer_el    = get_v(a_capex, "computer_el"),
    electricity    = get_v(a_opex, "electricity"),
    chemicals      = get_v(a_feed, "chemicals") + get_v(a_opex, "chemicals"),
    legal_acc      = get_v(a_opex, "legal_acc"),
    repair_inst    = get_v(a_opex, "repair_inst"),
    land_transp    = get_v(a_opex, "land_transp")
  )
  
  a_imp <- c(
    agriculture_imp = get_v(a_feed, "agriculture_imp"),
    food_bev_imp    = get_v(a_feed, "food_bev_imp")
  )
  
  list(
  a_dom = a_dom,
  a_imp = a_imp,
  gate_fee_coeff = gate_fee_coeff
)
}


## now technical coefficient vector for the final biofuel product
## works for BASE_2023 as well as future scenarios.
## Scenario-specific values (e.g. 2023 market values / CAPEX / OPEX distributions)
## override IVC_TECH_LIBRARY; otherwise the technology library is used as fallback.


build_fuel_column <- function(fuel_cfg) {
  
  weights <- fuel_cfg$weights
  ivc_ids <- names(weights)
  
  a_dom_agg <- NULL
  a_imp_agg <- NULL
gate_fee_coeff_agg <- 0
  
  for (ivc_id in ivc_ids) {
    
    w <- weights[[ivc_id]]
    
    tech_base <- IVC_TECH_LIBRARY[[ivc_id]]
    if (is.null(tech_base)) tech_base <- list()
    
    # Production cost: scenario-specific first, otherwise technology library
    ivc_prod_cost <- NULL
    if (!is.null(fuel_cfg$prod_cost)) {
      ivc_prod_cost <- fuel_cfg$prod_cost[[ivc_id]]
    }
    if (is.null(ivc_prod_cost)) ivc_prod_cost <- tech_base$prod_cost
    
    # Market value: scenario-specific first, otherwise technology library
    ivc_market_value <- NULL
    if (!is.null(fuel_cfg$market_value)) {
      ivc_market_value <- fuel_cfg$market_value[[ivc_id]]
    }
    if (is.null(ivc_market_value)) ivc_market_value <- tech_base$market_value
    
    # CAPEX distribution: scenario-specific first, otherwise technology library
    ivc_dist_capex <- NULL
    if (!is.null(fuel_cfg$dist_capex)) {
      ivc_dist_capex <- fuel_cfg$dist_capex[[ivc_id]]
    }
    if (is.null(ivc_dist_capex)) ivc_dist_capex <- tech_base$dist_capex
    
    # OPEX distribution: scenario-specific first, otherwise technology library
    ivc_dist_opex <- NULL
    if (!is.null(fuel_cfg$dist_opex)) {
      ivc_dist_opex <- fuel_cfg$dist_opex[[ivc_id]]
    }
    if (is.null(ivc_dist_opex)) ivc_dist_opex <- tech_base$dist_opex
    
    if (is.null(ivc_prod_cost) || is.null(ivc_market_value) ||
        is.null(ivc_dist_capex) || is.null(ivc_dist_opex)) {
      stop(paste("Missing technology input for", ivc_id))
    }
    
    ivc_res <- build_ivc_vector(
      prod_cost    = ivc_prod_cost,
      market_value = ivc_market_value,
      alpha_cost   = fuel_cfg$alpha[[ivc_id]],
      dist_feed    = fuel_cfg$dist_feed[[ivc_id]],
      dist_capex   = ivc_dist_capex,
      dist_opex    = ivc_dist_opex
    )
    
    # Initialise aggregate vectors based on the first active IVC
    if (is.null(a_dom_agg)) {
      a_dom_agg <- setNames(numeric(length(ivc_res$a_dom)), names(ivc_res$a_dom))
      a_imp_agg <- setNames(numeric(length(ivc_res$a_imp)), names(ivc_res$a_imp))
    }
    
    # Weighted aggregation across IVCs
    a_dom_agg <- a_dom_agg + w * ivc_res$a_dom
    a_imp_agg <- a_imp_agg + w * ivc_res$a_imp
   gate_fee_coeff_agg <- gate_fee_coeff_agg + w * ivc_res$gate_fee_coeff
  }
  
  list(
  a_dom = a_dom_agg,
  a_imp = a_imp_agg,
  gate_fee_coeff = gate_fee_coeff_agg
)
}



