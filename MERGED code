# Helper: find column/row index in IO table by name; fallback to manual index key if user supplied numeric
get_io_index <- function(name_or_index, io_df) {
  if (is.numeric(name_or_index)) return(as.integer(name_or_index))
  # if exact match in colnames or rownames use that
  cn <- colnames(io_df)
  rn <- rownames(io_df)
  if (!is.null(cn) && name_or_index %in% cn) return(which(cn == name_or_index))
  if (!is.null(rn) && name_or_index %in% rn) return(which(rn == name_or_index))
  # fuzzy match: try case-insensitive partial match in column names
  match_i <- grep(tolower(name_or_index), tolower(cn), value = FALSE)
  if (length(match_i) == 1) return(match_i)
  # last resort: NA
  return(NA_integer_)
}

