# Robust builder function
build_ivc_vector <- function(prod_cost, market_value, alpha_cost, dist_feed, dist_capex, dist_opex) {
  # Ensure alpha vectors exist and sum approximately 1
  if (is.null(alpha_cost) || abs(sum(alpha_cost) - 1.0) > 1e-3) {
    stop("alpha_cost must be provided and sum to (approximately) 1.0")
  }
  # Make sure distribution vectors are named numeric; if some keys missing, treat them as zero
  make_named <- function(vec) {
    if (is.null(vec)) return(setNames(numeric(0), character(0)))
    if (is.numeric(vec) && is.null(names(vec))) stop("Distribution vectors must be named")
    return(vec)
  }
  dist_feed <- make_named(dist_feed)
  dist_capex <- make_named(dist_capex)
  dist_opex <- make_named(dist_opex)

  # Tier 1
  r_k <- prod_cost / market_value

  # Tier 2
  s_feed  <- as.numeric(r_k * alpha_cost["feed"])
  s_capex <- as.numeric(r_k * alpha_cost["capex"])
  s_opex  <- as.numeric(r_k * alpha_cost["opex"])

  # Tier 3
  a_feed  <- if (length(dist_feed) > 0) s_feed * dist_feed else numeric(0)
  a_capex <- if (length(dist_capex) > 0) s_capex * dist_capex else numeric(0)
  a_opex  <- if (length(dist_opex) > 0) s_opex * dist_opex else numeric(0)

  get_v <- function(vec, k) if (!is.null(vec) && k %in% names(vec)) unname(vec[k]) else 0

  a_dom <- c(
    agriculture  = get_v(a_feed, "agriculture"),
    forestry     = get_v(a_feed, "forestry"),
    paper        = get_v(a_feed, "paper"),
    food_bev     = get_v(a_feed, "food_bev"),
    sewerage     = get_v(a_feed, "sewerage"),
    fab_metal    = get_v(a_capex, "fab_metal"),
    elec_equip   = get_v(a_capex, "elec_equip"),
    machinery    = get_v(a_capex, "machinery"),
    construction = get_v(a_capex, "construction"),
    architecture = get_v(a_capex, "architecture"),
    computer_opt = get_v(a_capex, "computer_opt"),
    electricity  = get_v(a_opex, "electricity"),
    chemicals    = get_v(a_feed, "chemicals") + get_v(a_opex, "chemicals"),
    legal_head   = get_v(a_opex, "legal_head"),
    repair_inst  = get_v(a_opex, "repair_inst"),
    land_transp  = get_v(a_opex, "land_transp")
  )

  a_imp <- c(
    agriculture_imp = get_v(a_feed, "agriculture_imp"),
    chemicals_imp   = get_v(a_feed, "chemicals_imp")
  )

  return(list(a_dom = a_dom, a_imp = a_imp))
}

