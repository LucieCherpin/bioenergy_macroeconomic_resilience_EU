## tentative output function
X = Z_dom + Z_imp + Y_dom + Exp + taxes

multipliers_all_scenarios <- data.frame()

# Loop through all scenario keys defined in scenario_config (e.g., "S1_2030", "S2_2030", "S3_2030")
for (scen_key in names(scenario_config)) {
  
  # 5.1 Initialize Scenario Matrices
## lists are initialized outside the loop to store the output matrices of each scenari without overwriting previosu results
  A_dom <- matrix(0, nrow = N, ncol = N)
  A_imp <- matrix(0, nrow = N, ncol = N)

  
  X_vec <- numeric(N)
  
  # 5.2 Loop through all fuel sectors active in the current scenario
## Instead of targeting only adv_biodiesel, this inner loop iterates through every active biofuel sector present in the current scenario configuration

  for (fuel_name in names(scenario_config[[scen_key]])) {
    
    if (!fuel_name %in% names(BIOFUEL_SECTORS)) next
    
    target_col <- BIOFUEL_SECTORS[[fuel_name]]
    
    # Extract absolute production value (EUR)
    X_vec[target_col] <- scenario_config[[scen_key]][[fuel_name]][["abs_production_eur"]]
    
    # Assemble technical input coefficients
    res_fuel <- build_fuel_column(fuel_name, scen_key)
    
    # Populate Domestic Technical Matrix A_dom
    for (sec_name in names(res_fuel$a_dom)) {
      if (sec_name %in% names(INPUT_SECTORS)) {
        row_idx <- INPUT_SECTORS[[sec_name]]
        A_dom[row_idx, target_col] <- res_fuel$a_dom[sec_name]
      }
    }
    
    # Populate Imported Technical Matrix A_imp
    ## The function build_ivc_vector() labels imported feedstocks with an _imp suffix (e.g., agriculture_imp).
    ##To map this coefficient to the correct input sector index in $A_{imp}$, gsub("_imp$", "", imp_sec) strips the string suffix so that agriculture_imp correctly evaluates to "agriculture", matching key 1 in INPUT_SECTORS.
    for (imp_sec in names(res_fuel$a_imp)) {
      clean_sec_name <- gsub("_imp$", "", imp_sec) # Strip "_imp" suffix to match INPUT_SECTORS
      if (clean_sec_name %in% names(INPUT_SECTORS)) {
        row_idx <- INPUT_SECTORS[[clean_sec_name]]
        A_imp[row_idx, target_col] <- res_fuel$a_imp[imp_sec]
      }
    }
  }

  ## populate primary inputs
  tax_coef <- res_fuel$tax_rate
    sum_dom  <- sum(A_dom[, target_col])
    sum_imp  <- sum(A_imp[, target_col])
    gva_coef <- 1 - (sum_dom + sum_imp + tax_coef)
    
    VA_mat[ROW_TAXES_LESS_SUBSIDIES, target_col] <- tax_coef
    VA_mat[ROW_GVA,                  target_col] <- gva_coef

  # 5.3 Absolute Transaction Matrices (Z)
  Z_dom <- A_dom %*% diag(X_vec)
  Z_imp <- A_imp %*% diag(X_vec)
  
  # 5.4 Leontief Inverse Matrix L = (I - A_dom)^(-1)
  L_dom <- solve(I_mat - A_dom)
  
  # Store scenario matrices into master lists
  A_dom_list[[scen_key]] <- A_dom
  A_imp_list[[scen_key]] <- A_imp
  Z_dom_list[[scen_key]] <- Z_dom
  Z_imp_list[[scen_key]] <- Z_imp
  L_dom_list[[scen_key]] <- L_dom
  
  # ===================================================================
  # 6. SCENARIO MULTIPLIER EXTRACTION
  # ===================================================================
  
  for (fuel_name in names(scenario_config[[scen_key]])) {
    if (!fuel_name %in% names(BIOFUEL_SECTORS)) next
    
    col_idx <- BIOFUEL_SECTORS[[fuel_name]]
    
    total_mult   <- sum(L_dom[, col_idx])
    direct_req   <- sum(A_dom[, col_idx])
    indirect_mult <- total_mult - 1 - direct_req
    tax_rate_val  <- VA_mat[ROW_TAXES_LESS_SUBSIDIES, col_idx]
    gva_rate_val  <- VA_mat[ROW_GVA, col_idx]
    
    multipliers_all_scenarios <- rbind(
      multipliers_all_scenarios, 
      data.frame(
        Scenario       = scen_key,
        Sector_Name    = fuel_name,
        IO_Index       = col_idx,
        Direct_Inputs  = round(direct_req, 4),
        Indirect_Mult  = round(indirect_mult, 4),
        Total_Output_M = round(total_mult, 4),
        Net_Tax_Coef   = round(tax_rate_val, 5),
        GVA_Coef       = round(gva_rate_val, 4),
        stringsAsFactors = FALSE
      )
    )
  }
}

# Print Multiplier Table across all scenarios
print("--- SUMMARY: BIOFUEL SECTOR MULTIPLIERS (ALL SCENARIOS) ---")
print(multipliers_all_scenarios)

