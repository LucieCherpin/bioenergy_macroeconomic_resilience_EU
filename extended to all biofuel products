res_adv_bio <- build_fuel_column("adv_biodiesel", "S1_2030")       ## R evaluates scenairo_config[["S1_2030"]][["adv_biodiesel"]] and temporarily stores these rules in fuel_cfg # calls Section 4 to obatin the final weighted input vector

# 3. Inject into Master Matrices
target_col <- BIOFUEL_SECTORS$adv_biodiesel

for (sec_name in names(res_adv_bio$a_dom)) {
  row_idx <- INPUT_SECTORS[[sec_name]]
  A_dom_S1_2030[row_idx, target_col] <- res_adv_bio$a_dom[sec_name]    
}

A_imp_S1_2030[INPUT_SECTORS$agriculture, target_col] <- res_adv_bio$a_imp["agriculture_imp"]
A_imp_S1_2030[INPUT_SECTORS$food_bev, target_col]    <- res_adv_bio$a_imp["food_bev_imp"]

# ===================================================================
# 6. ABSOLUTE FLOWS
# ===================================================================
# Create macro production vector X and calculate Euro transaction matrices Z

# 1. Initialize empty N-length vector for domestic production X
X_S1_2030 <- numeric(N)

# 2. Populate X from scenario_config targets
for (fuel_name in names(scenario_config[["S1_2030"]])) {
  col_idx <- BIOFUEL_SECTORS[[fuel_name]]
  X_S1_2030[col_idx] <- scenario_config[["S1_2030"]][[fuel_name]][["abs_production_eur"]]    ##### Here I pick up the absolute produced amount. 
}

# 3. Calculate absolute intermediate transaction matrices Z (in € Millions)
# Z_dom_ij = A_dom_ij * X_j
Z_dom_S1_2030 <- A_dom_S1_2030 %*% diag(X_S1_2030)
Z_imp_S1_2030 <- A_imp_S1_2030 %*% diag(X_S1_2030)

# ===================================================================
# 7. LEONTIEF INVERSE & MULTIPLIER ANALYSIS
# ===================================================================

# Step 1: Create N x N Identity Matrix
### check exactly what this is
I_mat <- diag(N)

# Step 2: Calculate Domestic Leontief Inverse L = (I - A_dom)^(-1)
# Note: solve() computes the matrix inverse in R
## subtracting A from I yields net output per unit of production
## inverting i calculates total gross utput required across all sectors to deliber 1 EUR of final demand to any single sector
L_dom_S1_2030 <- solve(I_mat - A_dom_S1_2030)


# Step 3: Extract Multipliers for Biofuel Sectors
# Initialize results data frame
biofuel_multipliers <- data.frame(
  Sector_Name    = character(),
  IO_Index       = integer(),
  Direct_Inputs  = numeric(),
  Indirect_Mult  = numeric(),
  Total_Output_M = numeric(),
  stringsAsFactors = FALSE
)

##### Loop through defined biofuel sectors to extract column metrics

## gets the column index correspnding to each fuel in scenario 1
for (fuel_name in names(scenario_config[["S1_2030"]])) {
  
  col_idx <- BIOFUEL_SECTORS[[fuel_name]]

## summing all rows i in colimn col_idx calculate ottal domestic gross output total doemstic gross output generates 
## across all sectors of the economy when final demand for that biofuel icnreases by 1 EUR
  # Total Output Multiplier = Column sum of Leontief Inverse
  total_mult <- sum(L_dom_S1_2030[, col_idx])
  
  # Direct Intermediate Requirement = Column sum of Technical Matrix A
  direct_req <- sum(A_dom_S1_2030[, col_idx])
  
  # Indirect Multiplier = Total - Initial Unit (€1) - Direct Inputs
  indirect_mult <- total_mult - 1 - direct_req
  
  # Append to results table
  biofuel_multipliers <- rbind(biofuel_multipliers, data.frame(
    Sector_Name    = fuel_name,
    IO_Index       = col_idx,
    Direct_Inputs  = round(direct_req, 4),
    Indirect_Mult  = round(indirect_mult, 4),
    Total_Output_M = round(total_mult, 4)
  ))
}

# Print summary table
print("--- BIOFUEL SECTOR MULTIPLIERS (S1 2030) ---")
print(biofuel_multipliers)

