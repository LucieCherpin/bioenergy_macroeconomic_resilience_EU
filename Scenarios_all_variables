build_endpoint <- function(scenario_cfg, import_cfg_eur) {


## biofuel-related sectors vs non-biofule reated sectors
  BIO <- unname(BIOFUEL_SECTORS)
  
  NONBIO <- setdiff(
    seq_len(nIndustries),
    BIO
  )
  
  # Start every scenario from the complete 2023 Eurostat IO economy.
  # Non-biofuel sectors therefore remain unchanged unless explicitly modified.
  A_dom_target <- A_dom
  A_imp_target <- A_imp
  X_target    <- q_s_dom
  
  
  X_target[BIO] <- 0
  ## new: added the imported finished biofuels going to final consumption expenditure
  Y_imp_FCE_target <-
    build_Y_imp_FCE(import_cfg_eur)
  
  
  # Replace only the biofuel sectors included in the respective scenario list.
  for (fuel_name in names(scenario_cfg)) {
    
    if (!fuel_name %in% names(BIOFUEL_SECTORS)) next
    
    target_col <- BIOFUEL_SECTORS[[fuel_name]]
    fuel_cfg   <- scenario_cfg[[fuel_name]]
    
    ##############################  ##############################  ##############################
    
    X_target[target_col] <- fuel_cfg$abs_production_eur / SCENARIO_EUR_TO_IO_UNIT
    
    # Scenario-specific technical coefficient column
    
    res_fuel <- build_fuel_column(fuel_cfg)
    
    # Replace, rather than supplement, the old IO technology column.
    A_dom_target[, target_col] <- 0
    A_imp_target[, target_col] <- 0
    
    for (sec_name in names(res_fuel$a_dom)) {
      
      if (sec_name %in% names(INPUT_SECTORS)) {
        
        row_idx <- INPUT_SECTORS[[sec_name]]
        
        A_dom_target[row_idx, target_col] <-
          res_fuel$a_dom[[sec_name]]
      }
    }
    
    for (imp_sec in names(res_fuel$a_imp)) {
      
      clean_sec <- gsub("_imp$", "", imp_sec)
      
      if (clean_sec %in% names(INPUT_SECTORS)) {
        
        row_idx <- INPUT_SECTORS[[clean_sec]]
        
        A_imp_target[row_idx, target_col] <-
          res_fuel$a_imp[[imp_sec]]
      }
    }
  }

  # ==========================================================
  # ENDOGENOUS OUTPUT RESPONSE OF NON-BIOFUEL SECTORS
  # ==========================================================
  
  # Scenario-specific biofuel production is exogenous
  X_bio_target <-
    X_target[BIO]
  
  # Keep final demand for non-biofuel products at 2023 level
  Y_nonbio_reference <-
    BASE_2023$Y_dom[NONBIO]
  
  # Input coefficients among non-biofuel sectors
  A_NN <-
    A_dom_target[
      NONBIO,
      NONBIO,
      drop = FALSE
    ]
  
  # Inputs supplied by non-biofuel sectors to biofuel sectors
  A_NB <-
    A_dom_target[
      NONBIO,
      BIO,
      drop = FALSE
    ]
  
  # Endogenous output of the non-biofuel economy
  X_nonbio_target <-
    solve(
      base::diag(length(NONBIO)) - A_NN,
      Y_nonbio_reference +
        A_NB %*% X_bio_target
    )
  
  # Insert endogenous non-biofuel output into complete X vector
  X_target[NONBIO] <-
    as.numeric(X_nonbio_target)
  
  Z_dom_target <-
    A_dom_target %*% base::diag(X_target)
  
  Z_imp_target <-
    A_imp_target %*% base::diag(X_target)
  
  Y_dom_target <-
    X_target - rowSums(Z_dom_target)
  
  L_dom_target <-
    solve(diag - A_dom_target)
  
  list(
    A_dom = A_dom_target,
    A_imp = A_imp_target,
    X     = X_target,
    Z_dom = Z_dom_target,
    Z_imp = Z_imp_target,
    Y_dom = Y_dom_target,
    Y_imp_FCE = Y_imp_FCE_target,
    L_dom = L_dom_target 
  )
}

