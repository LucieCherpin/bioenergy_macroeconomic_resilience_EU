##########################################
### STEP 5: Column assembly engine: generic function to create technical coefficient column for a given fuel
##########################################

build_fuel_column <- function(fuel_name, scenario_year_key) {
  if (is.null(scenario_config[[scenario_year_key]])) stop("Scenario key not found: ", scenario_year_key)
  fuel_cfg <- scenario_config[[scenario_year_key]][[fuel_name]]
  if (is.null(fuel_cfg)) stop("Fuel configuration not found for fuel: ", fuel_name, " in scenario ", scenario_year_key)
  weights <- fuel_cfg$weights

  # a_dom vector length = number of distinct domestic input categories in build_ivc_vector()
  sample_ivc <- IVC_TECH_LIBRARY[[names(weights)[1]]]
  if (is.null(sample_ivc)) stop("IVC ", names(weights)[1], " missing from IVC_TECH_LIBRARY")
  
  num_dom <- length(build_ivc_vector(sample_ivc$prod_cost, sample_ivc$market_value, sample_ivc$alpha, 
                                     fuel_cfg$dist_feed[[names(weights)[1]]], sample_ivc$dist_capex, sample_ivc$dist_opex)$a_dom)
  a_dom_aggregate <- numeric(num_dom)
  a_imp_aggregate <- numeric(2) # agriculture_imp, chemicals_imp

  # Loop over IVCs
  for (ivc_id in names(weights)) {
    w_k <- weights[ivc_id]
    tech_base <- IVC_TECH_LIBRARY[[ivc_id]]
    if (is.null(tech_base)) {
      stop("IVC not found in IVC_TECH_LIBRARY: ", ivc_id)
    }
    dist_feed_k <- fuel_cfg$dist_feed[[ivc_id]]
    ivc_res <- build_ivc_vector(
      prod_cost    = tech_base$prod_cost,
      market_value = tech_base$market_value,
      alpha_cost   = tech_base$alpha,
      dist_feed    = dist_feed_k,
      dist_capex   = tech_base$dist_capex,
      dist_opex    = tech_base$dist_opex
    )
    if (is.null(names(a_dom_aggregate))) names(a_dom_aggregate) <- names(ivc_res$a_dom)
    if (is.null(names(a_imp_aggregate))) names(a_imp_aggregate) <- names(ivc_res$a_imp)

    a_dom_aggregate <- a_dom_aggregate + (w_k * ivc_res$a_dom)
    a_imp_aggregate <- a_imp_aggregate + (w_k * ivc_res$a_imp)
  }

  # Preserve names
  names(a_dom_aggregate) <- names(ivc_res$a_dom)
  names(a_imp_aggregate) <- names(ivc_res$a_imp)

  return(list(a_dom = a_dom_aggregate, a_imp = a_imp_aggregate))
}

