# ===================================================================
# 2. CORE COEFFICIENT CALCULATOR FUNCTION
# ===================================================================

build_ivc_vector <- function(prod_cost, market_value, 
                             alpha_cost, 
                             dist_feed, dist_capex, dist_opex) {
# Validates that Level 2 shares sum to 1.0 (100% of production costs)
  stopifnot(abs(sum(alpha_cost) - 1.0) < 1e-3)

# Validates that Level 3 nested distribution vectors sum to 1.0 (100%)
  stopifnot(
    abs(sum(dist_feed) - 1.0) < 1e-3,
    abs(sum(dist_capex) - 1.0) < 1e-3,
    abs(sum(dist_opex) - 1.0) < 1e-3

##### TIER 1: Cost-to-Value Ratio (r_k = P_k / X_k) ---
  r_k <- prod_cost / market_value

##### TIER 2: Macro Shares Relative to Total Market Output Value (S = r_k * alpha) ---
  s_feed  <- r_k * alpha_cost["feed"]
  s_capex <- r_k * alpha_cost["capex"]
  s_opex  <- r_k * alpha_cost["opex"]

#### TIER 3: Absolute Technical Coefficients (a_ij = S * s_ij) ---
  a_feed  <- s_feed  * dist_feed
  a_capex <- s_capex * dist_capex
  a_opex  <- s_opex  * dist_opex

  
  # Merges into unified domestic input vector
### here I still need to add ALL feedstock inputs that exist (other biofuel sectors and maybe more?)
  a_dom <- c(
    agriculture  = unname(a_feed["agriculture"]), 
    forestry     = unname(a_feed["forestry"]), 
    paper        = unname(a_feed["paper"]), 
    food_bev     = unname(a_feed["food_bev"]), 
    sewerage     = unname(a_feed["sewerage"]),
    chemicals    = unname(a_feed["chemicals"]),
    adv_biodie   = unname(a_feed["adv_biodie"]),
    fab_metal    = unname(a_capex["fab_metal"]), 
    elec_equip   = unname(a_capex["elec_equip"]), 
    machinery    = unname(a_capex["machinery"]), 
    construction = unname(a_capex["construction"]), 
    architecture = unname(a_capex["architecture"]), 
    computer_opt = unname(a_capex["computer_opt"]),
    electricity  = unname(a_opex["electricity"]), 
    chemicals    = unname(a_opex["chemicals"]), 
    legal_head   = unname(a_opex["legal_head"]), 
    repair_inst  = unname(a_opex["repair_inst"]), 
    land_transp  = unname(a_opex["land_transp"])
  )
  
  a_imp <- c(agriculture_imp = unname(a_feed["agriculture_imp"]))
  
 return(list(
    r_k     = r_k,
    s_feed  = s_feed,
    s_capex = s_capex,
    s_opex  = s_opex,
    a_dom   = a_dom, 
    a_imp   = a_imp
  ))
}

