# ===================================================================
# 4. UPDATED UNIVERSAL COLUMN ASSEMBLY ENGINE
# ===================================================================

build_fuel_column <- function(fuel_name, scenario_year_key) {
  
  fuel_cfg <- scenario_config[[scenario_year_key]][[fuel_name]]    ## 
  weights  <- fuel_cfg$weights
  
  # Run sample IVC to dynamically extract structure length & names
  sample_ivc <- names(weights)[1]       ### picks the first actvie IVC listed in the scenario, i.e. IVC1 (FAME)
  sample_res <- build_ivc_vector(
    prod_cost    = IVC_TECH_LIBRARY[[sample_ivc]]$prod_cost,
    market_value = IVC_TECH_LIBRARY[[sample_ivc]]$market_value,
    alpha_cost   = IVC_TECH_LIBRARY[[sample_ivc]]$alpha,
    dist_feed    = fuel_cfg$dist_feed[[sample_ivc]],
    dist_capex   = IVC_TECH_LIBRARY[[sample_ivc]]$dist_capex,
    dist_opex    = IVC_TECH_LIBRARY[[sample_ivc]]$dist_opex
  )
  
  a_dom_aggregate <- setNames(numeric(length(sample_res$a_dom)), names(sample_res$a_dom))
  a_imp_aggregate <- setNames(numeric(length(sample_res$a_imp)), names(sample_res$a_imp))
  
  # Loop over active IVCs and aggregate
  for (ivc_id in names(weights)) {
    w_k <- weights[ivc_id]

    tech_base <- IVC_TECH_LIBRARY[[ivc_id]]
    
    ivc_res <- build_ivc_vector(
      prod_cost    = tech_base$prod_cost,
      market_value = tech_base$market_value,
      alpha_cost   = tech_base$alpha,
      dist_feed    = fuel_cfg$dist_feed[[ivc_id]],
      dist_capex   = tech_base$dist_capex,
      dist_opex    = tech_base$dist_opex
    )
    
    a_dom_aggregate <- a_dom_aggregate + (w_k * ivc_res$a_dom)
    a_imp_aggregate <- a_imp_aggregate + (w_k * ivc_res$a_imp)
  }
  
  return(list(a_dom = a_dom_aggregate, a_imp = a_imp_aggregate))
}


