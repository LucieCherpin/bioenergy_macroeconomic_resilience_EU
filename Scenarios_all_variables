    # ===============================================================

    L_dom_current <-
  solve(
    base::diag(nIndustries) -
      A_dom_IO_current
  )


    # ===============================================================
    # 10. STORE THIS YEAR
    # ===============================================================
A_dom_IO_path[i, , ] <-
  A_dom_IO_current

A_imp_IO_path[i, , ] <-
  A_imp_IO_current
   

X_path[i, ] <-
      X_current

    Y_dom_path[i, ] <-
      Y_dom_current

