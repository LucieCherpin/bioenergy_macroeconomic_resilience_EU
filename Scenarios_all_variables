# ===================================================================
# LINEAR TRANSITION BETWEEN TWO FIXED ENDPOINTS
# ===================================================================

build_linear_segment <- function(
    start_endpoint,
    end_endpoint,
    start_year,
    end_year
) {
  
  # Define biofuel and non-biofuel sectors locally
  BIO <- unname(BIOFUEL_SECTORS)
  
  NONBIO <- setdiff(
    seq_len(nIndustries),
    BIO
  )
  
  years <- start_year:end_year


  # ---------------------------------------------------------------
  # Storage
  # ---------------------------------------------------------------
  
  A_dom_path <- array(
    NA_real_,
    dim = c(n_years, nIndustries, nIndustries),
    dimnames = list(
      year = as.character(years),
      input_sector = NULL,
      output_sector = NULL
    )
  )
  
  A_imp_path <- array(
    NA_real_,
    dim = c(n_years, nIndustries, nIndustries),
    dimnames = list(
      year = as.character(years),
      input_sector = NULL,
      output_sector = NULL
    )
  )
  
  X_path <- matrix(
    NA_real_,
    nrow = n_years,
    ncol = nIndustries,
    dimnames = list(
      year = as.character(years),
      sector = NULL
    )
  )
  Z_dom_path <- array(
    NA_real_,
    dim = c(n_years, nIndustries, nIndustries),
    dimnames = list(
      year = as.character(years),
      input_sector = NULL,
      output_sector = NULL
    )
  )
  
  Z_imp_path <- array(
    NA_real_,
    dim = c(n_years, nIndustries, nIndustries),
    dimnames = list(
      year = as.character(years),
      input_sector = NULL,
      output_sector = NULL
    )
  )
  
  Y_dom_path <- matrix(
    NA_real_,
    nrow = n_years,
    ncol = nIndustries,
    dimnames = list(
      year = as.character(years),
      sector = NULL
    )
  )
  
  L_dom_path <- array(
    NA_real_,
    dim = c(n_years, nIndustries, nIndustries),
    dimnames = list(
      year = as.character(years),
      input_sector = NULL,
      output_sector = NULL
    )
  )
  
  # ---------------------------------------------------------------
  # Annual interpolation
  # ---------------------------------------------------------------
  
  
  for (i in seq_along(years)) {
    
    current_year <- years[i]
    
    lambda <-
      (current_year - start_year) /
      (end_year - start_year)
    
    
    # Linear technical coefficient development
    A_dom_current <-
      start_endpoint$A_dom +
      lambda * (
        end_endpoint$A_dom -
          start_endpoint$A_dom
      )
    
    A_imp_current <-
      start_endpoint$A_imp +
      lambda * (
        end_endpoint$A_imp -
          start_endpoint$A_imp
      )
##################################################
###### Neu: also for the transition between 2023 and 2030, the BIO and NONBIO sectors evolve differently: X(BIO) evolves linearly  between fixed 2023 starting point and 2030 ending point; but X NONBIO evolves endogensouly  dependent on changed demand of biofuels

# ==========================================================
# BIOFUEL OUTPUT: LINEAR EXOGENOUS DEVELOPMENT
# ==========================================================

X_current <- numeric(nIndustries)

X_current[BIO] <-
  start_endpoint$X[BIO] +
  lambda * (
    end_endpoint$X[BIO] -
      start_endpoint$X[BIO]
  )


# ==========================================================
# NON-BIOFUEL OUTPUT: ENDOGENOUS RESPONSE
# ==========================================================

A_NN_current <-
  A_dom_current[
    NONBIO,
    NONBIO,
    drop = FALSE
  ]

A_NB_current <-
  A_dom_current[
    NONBIO,
    BIO,
    drop = FALSE
  ]

Y_nonbio_current <-
  start_endpoint$Y_dom[NONBIO] +
  lambda * (
    end_endpoint$Y_dom[NONBIO] -
      start_endpoint$Y_dom[NONBIO]
  )

X_current[NONBIO] <-
  as.numeric(
    solve(
      base::diag(length(NONBIO)) - A_NN_current,
      Y_nonbio_current +
        A_NB_current %*% X_current[BIO]
    )
  )

#############################################################
##### Z resuls fro A and X ##################################
###### note:  X_Currrent is still teh full 73-sector outputp vector containing both X_BIO and X_NONBIO
#############################################################
    
    # Z follows from that year's A and X
    Z_dom_current <-
      A_dom_current %*% base::diag(X_current)
    
    Z_imp_current <-
      A_imp_current %*% base::diag(X_current)
    
    
    # Y as accounting residual
    Y_dom_current <-
      X_current - rowSums(Z_dom_current)
    
    
    # Annual Leontief inverse
    L_dom_current <-
      solve(diag - A_dom_current)
    # -------------------------------------------------------------
    # Store
    # -------------------------------------------------------------
    
    A_dom_path[i, , ] <- A_dom_current
    A_imp_path[i, , ] <- A_imp_current
    X_path[i, ] <- X_current
    Z_dom_path[i, , ] <- Z_dom_current
    Z_imp_path[i, , ] <- Z_imp_current
    
    Y_dom_path[i, ] <- Y_dom_current
    
    L_dom_path[i, , ] <- L_dom_current
  }
  
  
  list(
    years    = years,
    A_dom    = A_dom_path,
    A_imp    = A_imp_path,
    X  = X_path,
    Y_dom = Y_dom_path,
    L_dom = L_dom_path,
    Z_dom = Z_dom_path,
    Z_imp = Z_imp_path
  )
}



